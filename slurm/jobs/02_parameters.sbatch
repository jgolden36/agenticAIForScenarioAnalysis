#!/bin/bash
#SBATCH --job-name=hormuz-params
#SBATCH --output=slurm/logs/02_params-%A_%a.out
#SBATCH --error=slurm/logs/02_params-%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --partition=batch
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=01:00:00
# Array size set dynamically by submit_pipeline.sh via --array=0-N

# ------------------------------------------------------------------
# Module 2: Parameter Extraction (SLURM Array Job)
#
# Each array task extracts parameters for one (scenario, model_spec)
# pair. With 4 scenarios × ~34 model specs, this creates ~136 array
# tasks that can run in parallel across the cluster.
#
# The manifest file (generated by dispatch_models.py) maps each
# SLURM_ARRAY_TASK_ID to its (scenario, model) pair.
#
# The LLM call is HTTP to a remote endpoint (cloud API or 00_vllm
# sidecar) -- no local GPU needed; a small CPU slot is sufficient.
#
# Error handling (see slurm/jobs/_common.sh): per-task failures are
# logged via record_bash_failure but the sbatch task still exits 0,
# so a single bad (scenario, model_spec) pair does not break the
# afterok dependency chain to Module 3.
# ------------------------------------------------------------------

set -uo pipefail

# shellcheck source=./_common.sh
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

STAGE="02_parameters"

echo "============================================="
echo "  Module 2: Parameter Extraction"
echo "  Array Job: ${SLURM_ARRAY_JOB_ID:-N/A} Task: ${SLURM_ARRAY_TASK_ID:-N/A}"
echo "  Node:      $(hostname)"
echo "  Run ID:    ${HORMUZ_RUN_ID:-not set}"
echo "  Date:      $(date)"
echo "============================================="

cd "${SLURM_SUBMIT_DIR}"

module purge 2>/dev/null || true
module load anaconda3 2>/dev/null || true

if ! hormuz_activate_conda "${HORMUZ_CONDA_ENV:-hormuz}"; then
    record_bash_failure "$STAGE" 1 "hormuz_activate_conda failed for env '${HORMUZ_CONDA_ENV:-hormuz}' on $(hostname)"
    echo "[task ${SLURM_ARRAY_TASK_ID:-N/A}] cannot activate conda env; skipping (continue_on_failure=1)"
    exit 0
fi

record_runtime_inventory "$STAGE"

# continue_on_failure=1: one task's failure (e.g. LLM timeout, malformed
# response) must not break the dependency chain. Module 3's
# dispatch_models.py only consumes the parameter files that *did* land,
# so partial failures degrade gracefully into "this model gets no
# parameter set this run" rather than aborting the pipeline.
safe_python "$STAGE" 1 -- python slurm/scripts/run_parameters.py

echo "Task ${SLURM_ARRAY_TASK_ID:-N/A} complete at $(date)"
exit 0
