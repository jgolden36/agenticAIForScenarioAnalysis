#!/bin/bash
# ==================================================================
# Hormuz Crisis Analysis Pipeline - Empire AI Alpha Weekly News Driver
#
# Production companion to slurm/jobs/empire_ai_alpha.job. Where the
# main driver runs Algorithm 1 once against a static crisis
# description, this driver demonstrates the framework's value for
# *rapid re-analysis as new information arrives*: it loops over
# calendar weeks, fetches the past week's news + EIA indicators,
# rewrites the crisis description, and reruns the full pipeline once
# per week.
#
# Outputs are isolated per week (HORMUZ_RUN_ID="weekly_<YYYYMMDD>"),
# so the resulting state files, model outputs, synthesis reports,
# and W&B run groups can be compared side-by-side to show how the
# agentic analysis evolves with new evidence.
#
# Targets the Empire AI Alpha cluster (Flatiron-hosted, SUNY
# allocation, alpha.empire-ai.org) and the SUNY-wide `suny`
# partition. References:
#   https://docs.ccr.buffalo.edu/en/latest/howto/empireai/
#   https://empireai.freshdesk.com/en/support/solutions/articles/157000168778-slurm-partitions-queues-
#
# Why a single multi-week driver instead of N independent jobs?
#   * Alpha enforces MaxJobsPU=30 and MaxSubmitPU=200. Submitting
#     ~9 jobs (one per week) plus their internal manifest array
#     tasks would collide with both limits. A single driver job with
#     an outer week loop and an inner manifest loop sidesteps this.
#   * The vLLM sidecar takes 5-15 minutes to load a 70B model.
#     Starting it once and reusing it across all weeks saves a *lot*
#     of wallclock vs. cold-starting per week.
#   * Empire AI Alpha compute nodes generally lack outbound HTTPS to
#     wandb.ai, so W&B runs buffer offline; one driver = one tarball
#     to ship from a login node afterwards.
#
# Pipeline executed per week (Algorithm 1 in the paper, plus the
# Module 6 weekly brief step). Each week produces the same artefact
# set as a single-run pipeline (synthesis, validation, CSV exports,
# qualitative narratives, figures dashboard) — isolated by run id.
#
#   00.  (optional, once) launch local vLLM
#   --   for each calendar week in [start, end]:
#   06.    Module 6 - build weekly brief + per-week crisis YAML
#   01.    Module 1 - scenario generation (using per-week YAML)
#   --     dispatch parameter manifest
#   02.    Module 2 - parameter extraction (loop over manifest)
#   --     dispatch model manifests (commodity, commodity_downstream, macro)
#   03.    Module 3 - model execution (loop over manifest)
#   04.    Module 4 - synthesis
#   04b.   Stage 4b - output validation (best-effort)
#   05.    Stage 5  - quantitative CSV + qualitative narrative export
#   06b.   Stage 6  - per-week visualization (figures + dashboard)
#   --   end for
#   07.  Stage 7 - cross-week evolution dashboard aggregating every
#                  week's CSVs into a single "how predictions evolve"
#                  index.html under data/reports/weekly_evolution/.
#
# All HITL checkpoints are auto-approved; for interactive review run
# `python -m src.pipeline.graph` locally instead.
#
# ------------------------------------------------------------------
# Submission examples
# ------------------------------------------------------------------
#   # Default: full Feb 15 - April 10 backfill, weekly cadence,
#   # 2 GPUs, vLLM sidecar on GPU 0, EIA Open Data only.
#   cd /mnt/home/$USER/agenticAIForScenarioAnalysis
#   export EIA_API_KEY=...                 # free, eia.gov/opendata
#   sbatch slurm/jobs/empire_ai_alpha_weekly.job
#
#   # Add commercial news sources for richer briefs:
#   export NEWSDATA_API_KEY=...
#   export GNEWS_API_KEY=...
#   export NEWSAPI_ORG_API_KEY=...
#   sbatch slurm/jobs/empire_ai_alpha_weekly.job
#
#   # Custom backfill window:
#   export HORMUZ_WEEKLY_START=2026-03-01
#   export HORMUZ_WEEKLY_END=2026-04-10
#   sbatch slurm/jobs/empire_ai_alpha_weekly.job
#
#   # Use a cloud LLM instead of local vLLM (saves 1 GPU, needs key):
#   export PIPELINE_LLM_PROVIDER=anthropic
#   export ANTHROPIC_API_KEY=sk-ant-...
#   export HORMUZ_USE_VLLM=0
#   sbatch --gpus-per-node=1 slurm/jobs/empire_ai_alpha_weekly.job
#
#   # Brief-only mode: build all weekly briefs but skip pipeline
#   # reruns. Useful for inspecting summariser quality before
#   # committing the full GPU walltime.
#   export HORMUZ_WEEKLY_SKIP_PIPELINE=1
#   sbatch --gpus-per-node=1 --time=06:00:00 slurm/jobs/empire_ai_alpha_weekly.job
#
#   # Larger model on 4 GPUs with tensor parallelism:
#   export HORMUZ_VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
#   export HORMUZ_VLLM_TP_SIZE=4
#   sbatch --gpus-per-node=4 slurm/jobs/empire_ai_alpha_weekly.job
#
# ------------------------------------------------------------------
# SBATCH directives
# ------------------------------------------------------------------
#SBATCH --job-name=hormuz-weekly
#SBATCH --partition=suny
#SBATCH --account=suny
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=2
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=7-00:00:00
#SBATCH --output=slurm/logs/empire_ai_alpha_weekly-%j.out
#SBATCH --error=slurm/logs/empire_ai_alpha_weekly-%j.err
#SBATCH --mail-type=END,FAIL
# Note: Alpha's `suny` partition uses `--gpus-per-node=N`, NOT
# `--gres=gpu:N`. Max walltime is 7 days; the default backfill is
# ~9 weeks of pipeline reruns so we cap at the maximum. For
# brief-only runs override at submission with --time=06:00:00.
# Submit with `sbatch --mail-user=you@stonybrook.edu ...` to receive
# completion notifications.
#
# Logging layout (per parent batch, one batch per `sbatch`):
#   slurm/logs/empire_ai_alpha_weekly-<jobid>.out    driver stdout
#   slurm/logs/empire_ai_alpha_weekly-<jobid>.err    driver stderr
#   slurm/logs/<batch_id>/                           per-batch sink:
#       driver-<jobid>.out / .err                    SBATCH symlinks
#       vllm.log                                     vLLM sidecar
#       runtime-*-<job>-<task>.json                  setup inventory
#       <YYYY-MM-DD>/                                per-week subfolder:
#           runtime-*-<job>-<task>.json              per-week stage inventories
#           wandb/offline-run-*                      per-week W&B runs

set -uo pipefail

# ------------------------------------------------------------------
# Resolve project root and source common helpers.
# ------------------------------------------------------------------
PROJECT_ROOT="${SLURM_SUBMIT_DIR:-$(pwd)}"
cd "$PROJECT_ROOT"

# shellcheck source=./_common.sh
source "${PROJECT_ROOT}/slurm/jobs/_common.sh"

STAGE_PREFIX="empire_ai_alpha_weekly"

# ------------------------------------------------------------------
# Batch identification + state directories.
#
# A "batch" is one sbatch invocation; it spans many week-level
# pipeline reruns. The parent batch ID groups everything in W&B and
# in slurm/logs/. Per-week run IDs (HORMUZ_RUN_ID="weekly_<date>")
# are set inside the loop so each week's state files, manifests,
# and synthesis reports stay isolated.
# ------------------------------------------------------------------
export HORMUZ_BATCH_ID="${HORMUZ_BATCH_ID:-$(date -u +%Y%m%d_%H%M%S)}"
export HORMUZ_CONDA_ENV="${HORMUZ_CONDA_ENV:-hormuz}"
export HORMUZ_CONFIG="${HORMUZ_CONFIG:-${PROJECT_ROOT}/slurm/config/pipeline_cluster.yaml}"
export HORMUZ_AUTO_APPROVE=1   # SLURM cannot prompt; HITL is auto-approved.

# Empire AI conventions: home is small/no quota for now, scratch is
# the right place for run artefacts (see EAI storage docs). We
# allocate one scratch tree per batch; per-week artefacts live
# beneath it.
EAI_SCRATCH_DEFAULT=""
if [[ -d "/mnt/lustre/suny/${USER}" ]]; then
    EAI_SCRATCH_DEFAULT="/mnt/lustre/suny/${USER}/hormuz/weekly_${HORMUZ_BATCH_ID}"
fi
export HORMUZ_BATCH_SCRATCH="${HORMUZ_BATCH_SCRATCH:-$EAI_SCRATCH_DEFAULT}"

mkdir -p "${PROJECT_ROOT}/slurm/logs"
mkdir -p "${PROJECT_ROOT}/data/pipeline_state/manifests"
mkdir -p "${PROJECT_ROOT}/data/inputs" "${PROJECT_ROOT}/data/outputs" "${PROJECT_ROOT}/data/reports"
if [[ -n "$HORMUZ_BATCH_SCRATCH" ]]; then
    mkdir -p "$HORMUZ_BATCH_SCRATCH"
fi

# ------------------------------------------------------------------
# Per-batch log directory. Mirrors the per-run pattern from
# empire_ai_alpha.job, but here BATCH_LOG_DIR is the *parent* and
# the per-week subfolders inside it are the equivalent of one run.
# We override HORMUZ_LOG_DIR per-week inside the loop.
# ------------------------------------------------------------------
BATCH_LOG_DIR="${PROJECT_ROOT}/slurm/logs/weekly_${HORMUZ_BATCH_ID}"
mkdir -p "$BATCH_LOG_DIR"
# Default value; will be overridden to a per-week subfolder inside
# the loop so per-week runtime/failure JSONs stay grouped.
export HORMUZ_LOG_DIR="$BATCH_LOG_DIR"

# Symlink the SBATCH driver out/err into the per-batch folder.
SBATCH_OUT="${PROJECT_ROOT}/slurm/logs/empire_ai_alpha_weekly-${SLURM_JOB_ID:-local}.out"
SBATCH_ERR="${PROJECT_ROOT}/slurm/logs/empire_ai_alpha_weekly-${SLURM_JOB_ID:-local}.err"
if [[ -n "${SLURM_JOB_ID:-}" ]]; then
    ln -sf "$SBATCH_OUT" "${BATCH_LOG_DIR}/driver-${SLURM_JOB_ID}.out" 2>/dev/null || true
    ln -sf "$SBATCH_ERR" "${BATCH_LOG_DIR}/driver-${SLURM_JOB_ID}.err" 2>/dev/null || true
fi

# ------------------------------------------------------------------
# Weekly backfill window + sources / baseline / output configs.
# Defaults span the full Hormuz crisis (Feb 15 - April 10, 2026).
# ------------------------------------------------------------------
HORMUZ_WEEKLY_START="${HORMUZ_WEEKLY_START:-2026-02-15}"
HORMUZ_WEEKLY_END="${HORMUZ_WEEKLY_END:-2026-04-10}"
HORMUZ_WEEKLY_STEP_DAYS="${HORMUZ_WEEKLY_STEP_DAYS:-7}"
HORMUZ_WEEKLY_SKIP_PIPELINE="${HORMUZ_WEEKLY_SKIP_PIPELINE:-0}"

HORMUZ_NEWS_CONFIG="${HORMUZ_NEWS_CONFIG:-${PROJECT_ROOT}/configs/news_sources.yaml}"
HORMUZ_BASELINE_CRISIS="${HORMUZ_BASELINE_CRISIS:-${PROJECT_ROOT}/configs/crisis_descriptions/hormuz_2026.yaml}"
HORMUZ_WEEKLY_CRISIS_DIR="${HORMUZ_WEEKLY_CRISIS_DIR:-${PROJECT_ROOT}/configs/crisis_descriptions/hormuz_2026_weekly}"
HORMUZ_NEWS_DATA_DIR="${HORMUZ_NEWS_DATA_DIR:-${PROJECT_ROOT}/data/news}"

mkdir -p "$HORMUZ_WEEKLY_CRISIS_DIR" "$HORMUZ_NEWS_DATA_DIR"

# ------------------------------------------------------------------
# Weights & Biases configuration.
#
# Identical resolution policy to empire_ai_alpha.job. The only
# difference is `WANDB_RUN_GROUP` is set to the parent batch by
# default and overridden to "weekly_<date>" inside the loop, so the
# W&B UI shows one logical group per week (and an outer batch group
# spanning all of them via tags).
#
# Empire AI Alpha compute nodes generally cannot reach wandb.ai over
# HTTPS, so the safe default is offline mode: wandb buffers runs to
# disk under WANDB_DIR and they are sync'd from a login node
# afterwards via:
#   wandb sync slurm/logs/weekly_<batch>/<date>/wandb/offline-run-*
# ------------------------------------------------------------------
export WANDB_PROJECT="${WANDB_PROJECT:-hormuz-pipeline}"
export WANDB_RUN_GROUP_BATCH="${WANDB_RUN_GROUP_BATCH:-weekly_${HORMUZ_BATCH_ID}}"
export WANDB_RUN_GROUP="${WANDB_RUN_GROUP:-$WANDB_RUN_GROUP_BATCH}"
export WANDB_MODE="${WANDB_MODE:-offline}"

# ╔════════════════════════════════════════════════════════════════╗
# ║  W&B API KEY - same three-tier resolution as empire_ai_alpha.job ║
# ║                                                                  ║
# ║   1. WANDB_API_KEY exported in the shell that ran sbatch         ║
# ║      (e.g. via ~/.bashrc, `wandb login`, or                      ║
# ║      `export WANDB_API_KEY=... && sbatch ...`). PREFERRED.       ║
# ║   2. A key file at ~/.wandb_api_key (mode 600/400 checked).      ║
# ║      PREFERRED for headless cluster runs.                        ║
# ║   3. The inline literal on WANDB_API_KEY_INLINE below.           ║
# ║      ONLY use in a private clone - .job files are tracked        ║
# ║      by git and committing a key would leak it.                  ║
# ║                                                                  ║
# ║  When a key is found AND WANDB_MODE was left at the default      ║
# ║  ("offline"), the job auto-flips to "online".                    ║
# ╚════════════════════════════════════════════════════════════════╝

# === EDIT BELOW ONLY IF USING OPTION 3 ===
WANDB_API_KEY_INLINE=""
# ==========================================

WANDB_API_KEY_FILE="${WANDB_API_KEY_FILE:-${HOME}/.wandb_api_key}"

if [[ -z "${WANDB_API_KEY:-}" ]]; then
    if [[ -n "$WANDB_API_KEY_INLINE" ]]; then
        export WANDB_API_KEY="$WANDB_API_KEY_INLINE"
        echo "[wandb] using inline WANDB_API_KEY_INLINE (consider moving to" \
             "$WANDB_API_KEY_FILE to keep secrets out of the .job file)"
    elif [[ -r "$WANDB_API_KEY_FILE" ]]; then
        perms=$(stat -c '%a' "$WANDB_API_KEY_FILE" 2>/dev/null || \
                stat -f '%Lp' "$WANDB_API_KEY_FILE" 2>/dev/null || echo "?")
        if [[ "$perms" != "600" && "$perms" != "400" && "$perms" != "?" ]]; then
            echo "[wandb] WARNING: $WANDB_API_KEY_FILE has permissions ${perms};" \
                 "tighten with: chmod 600 $WANDB_API_KEY_FILE"
        fi
        WANDB_API_KEY=$(grep -v '^[[:space:]]*#' "$WANDB_API_KEY_FILE" | \
                        sed '/^[[:space:]]*$/d' | head -n1 | tr -d '[:space:]')
        if [[ -n "$WANDB_API_KEY" ]]; then
            export WANDB_API_KEY
            echo "[wandb] loaded WANDB_API_KEY from $WANDB_API_KEY_FILE"
        fi
    fi
fi

if [[ -n "${WANDB_API_KEY:-}" && "$WANDB_MODE" == "offline" \
      && -z "${HORMUZ_WANDB_FORCE_OFFLINE:-}" ]]; then
    export WANDB_MODE="online"
    echo "[wandb] WANDB_API_KEY detected; auto-switching WANDB_MODE=online." \
         "Set HORMUZ_WANDB_FORCE_OFFLINE=1 to keep offline mode anyway."
fi

# Pin wandb's local cache + run dir under the per-batch log folder.
# The actual per-week WANDB_DIR override happens inside the loop so
# each week's offline runs land under <batch>/<date>/wandb/.
export WANDB_DIR="${WANDB_DIR:-${BATCH_LOG_DIR}}"
export WANDB_CACHE_DIR="${WANDB_CACHE_DIR:-${BATCH_LOG_DIR}/wandb-cache}"
export WANDB_CONFIG_DIR="${WANDB_CONFIG_DIR:-${BATCH_LOG_DIR}/wandb-config}"
mkdir -p "$WANDB_DIR" "$WANDB_CACHE_DIR" "$WANDB_CONFIG_DIR"
export WANDB_SILENT="${WANDB_SILENT:-true}"
export WANDB_CONSOLE="${WANDB_CONSOLE:-off}"
export HORMUZ_WANDB_LOG_PER_TASK="${HORMUZ_WANDB_LOG_PER_TASK:-1}"

# Tag every per-week W&B run with the batch group so the UI's tag
# filter cleanly groups the whole multi-week experiment.
export WANDB_TAGS="${WANDB_TAGS:-temporal,weekly,${WANDB_RUN_GROUP_BATCH}}"

echo "[wandb] project=${WANDB_PROJECT} batch_group=${WANDB_RUN_GROUP_BATCH} mode=${WANDB_MODE}"
echo "[wandb] dir=${WANDB_DIR} per_task=${HORMUZ_WANDB_LOG_PER_TASK}"
case "$WANDB_MODE" in
    online)
        if [[ -z "${WANDB_API_KEY:-}" ]]; then
            echo "[wandb] WARNING: WANDB_MODE=online but WANDB_API_KEY is unset."
            echo "[wandb]          The Python wrapper will downgrade to disabled."
        fi
        ;;
    offline)
        echo "[wandb] runs will be written to per-week wandb/ subfolders;"
        echo "[wandb] sync from a login node with:"
        echo "[wandb]   wandb sync ${BATCH_LOG_DIR}/*/wandb/offline-run-*"
        ;;
    disabled)
        echo "[wandb] disabled via WANDB_MODE; pipeline runs without tracking."
        ;;
esac

echo "================================================================"
echo "  Hormuz Pipeline - Empire AI Alpha (weekly news driver)"
echo "================================================================"
echo "  Job ID:           ${SLURM_JOB_ID:-N/A}"
echo "  Batch ID:         ${HORMUZ_BATCH_ID}"
echo "  Window:           ${HORMUZ_WEEKLY_START} .. ${HORMUZ_WEEKLY_END} (step=${HORMUZ_WEEKLY_STEP_DAYS}d)"
echo "  Skip pipeline?    ${HORMUZ_WEEKLY_SKIP_PIPELINE} (1 = brief-only)"
echo "  Node:             $(hostname -f 2>/dev/null || hostname)"
echo "  Partition:        ${SLURM_JOB_PARTITION:-suny}"
echo "  CPUs:             ${SLURM_CPUS_PER_TASK:-?}"
echo "  GPUs on node:     ${SLURM_GPUS_ON_NODE:-?}"
echo "  Memory:           ${SLURM_MEM_PER_NODE:-?} MB"
echo "  Walltime cap:     ${SBATCH_TIMELIMIT:-from-script}"
echo "  Project root:     ${PROJECT_ROOT}"
echo "  Conda env:        ${HORMUZ_CONDA_ENV}"
echo "  Pipeline config:  ${HORMUZ_CONFIG}"
echo "  News config:      ${HORMUZ_NEWS_CONFIG}"
echo "  Baseline crisis:  ${HORMUZ_BASELINE_CRISIS}"
echo "  Per-week YAMLs:   ${HORMUZ_WEEKLY_CRISIS_DIR}"
echo "  News artefacts:   ${HORMUZ_NEWS_DATA_DIR}"
echo "  Batch scratch:    ${HORMUZ_BATCH_SCRATCH:-<unset, using project root>}"
echo "  Batch log dir:    ${BATCH_LOG_DIR}"
echo "  Driver out:       ${SBATCH_OUT}"
echo "  Driver err:       ${SBATCH_ERR}"
echo "  W&B project:      ${WANDB_PROJECT} (batch_group=${WANDB_RUN_GROUP_BATCH})"
echo "  Started at:       $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "================================================================"

# ------------------------------------------------------------------
# Modules (Alpha's module set is small; failures are recorded but
# non-fatal -- the conda env is the real source of dependencies).
# ------------------------------------------------------------------
module purge 2>/dev/null || true
module load anaconda3        2>/dev/null || echo "[module] anaconda3 not available; relying on PATH"
module load cuda/12.4        2>/dev/null || module load cuda 2>/dev/null || echo "[module] no cuda module loaded"
module load cudnn/9.0        2>/dev/null || echo "[module] no cudnn module loaded"

if ! hormuz_activate_conda "${HORMUZ_CONDA_ENV}"; then
    record_bash_failure "${STAGE_PREFIX}_setup" 1 \
        "hormuz_activate_conda failed for env '${HORMUZ_CONDA_ENV}' on $(hostname)"
    echo "[fatal] cannot activate conda env '${HORMUZ_CONDA_ENV}'; aborting."
    exit 1
fi

record_runtime_inventory "${STAGE_PREFIX}_setup"

# ------------------------------------------------------------------
# At-least-one-source check. The aggregator silently skips sources
# that fail to initialise, but it's much friendlier to fail fast at
# submission time when *no* source has a key set. EIA Open Data is
# the easiest free option (eia.gov/opendata/register.php).
# ------------------------------------------------------------------
KEYS_PRESENT=0
for VAR in EIA_API_KEY NEWSDATA_API_KEY GNEWS_API_KEY NEWSAPI_ORG_API_KEY NEWSAPI_AI_API_KEY; do
    if [[ -n "${!VAR:-}" ]]; then
        echo "[news] $VAR is set"
        KEYS_PRESENT=$((KEYS_PRESENT + 1))
    fi
done
if [[ $KEYS_PRESENT -eq 0 ]]; then
    record_bash_failure "${STAGE_PREFIX}_setup" 1 \
        "No news/EIA API keys present in the environment."
    echo "[fatal] No news/EIA API keys present in the environment. Set at"
    echo "        least one of: EIA_API_KEY (free, eia.gov/opendata),"
    echo "        NEWSDATA_API_KEY, GNEWS_API_KEY, NEWSAPI_ORG_API_KEY,"
    echo "        NEWSAPI_AI_API_KEY and resubmit."
    exit 1
fi

# ------------------------------------------------------------------
# Optional vLLM sidecar on the local node (default: ON), shared
# across all weeks. Empire AI Alpha generally has no outbound HTTPS
# to commercial LLM APIs from compute nodes, so the safe default is
# local inference. To use Anthropic/OpenAI/Bedrock instead, set:
#   export HORMUZ_USE_VLLM=0
#   export PIPELINE_LLM_PROVIDER=anthropic   # or openai / bedrock
#   export ANTHROPIC_API_KEY=...
# before submitting.
# ------------------------------------------------------------------
HORMUZ_USE_VLLM="${HORMUZ_USE_VLLM:-1}"
PIPELINE_LLM_PROVIDER="${PIPELINE_LLM_PROVIDER:-vllm}"
export PIPELINE_LLM_PROVIDER

VLLM_PID=""
cleanup_vllm() {
    if [[ -n "$VLLM_PID" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
        echo "[vllm] stopping sidecar (pid=$VLLM_PID)"
        kill "$VLLM_PID" 2>/dev/null || true
        sleep 2
        kill -9 "$VLLM_PID" 2>/dev/null || true
    fi
}
trap cleanup_vllm EXIT TERM INT

if [[ "$HORMUZ_USE_VLLM" == "1" && "$PIPELINE_LLM_PROVIDER" == "vllm" ]]; then
    if ! python -c "import vllm" 2>/dev/null; then
        record_bash_failure "${STAGE_PREFIX}_vllm" 1 \
            "vllm not installed in conda env '${HORMUZ_CONDA_ENV}'"
        echo "[fatal] vllm not installed. Try: pip install vllm"
        echo "        Or rerun with HORMUZ_USE_VLLM=0 + a cloud provider."
        exit 1
    fi

    VLLM_MODEL="${HORMUZ_VLLM_MODEL:-meta-llama/Llama-3.1-8B-Instruct}"
    VLLM_PORT="${HORMUZ_VLLM_PORT:-8000}"
    VLLM_TP_SIZE="${HORMUZ_VLLM_TP_SIZE:-1}"
    VLLM_DTYPE="${HORMUZ_VLLM_DTYPE:-auto}"
    VLLM_MAX_LEN="${HORMUZ_VLLM_MAX_LEN:-8192}"
    VLLM_GPUS="${HORMUZ_VLLM_GPUS:-0}"

    NODE_HOST="$(hostname -f 2>/dev/null || hostname)"
    VLLM_LOG="${BATCH_LOG_DIR}/vllm.log"

    echo "[vllm] starting sidecar on ${NODE_HOST}:${VLLM_PORT}"
    echo "       model=${VLLM_MODEL} tp=${VLLM_TP_SIZE} dtype=${VLLM_DTYPE} gpus=${VLLM_GPUS}"
    echo "       log:   ${VLLM_LOG}"

    CUDA_VISIBLE_DEVICES="$VLLM_GPUS" \
        python -m vllm.entrypoints.openai.api_server \
            --model "${VLLM_MODEL}" \
            --port "${VLLM_PORT}" \
            --host 0.0.0.0 \
            --tensor-parallel-size "${VLLM_TP_SIZE}" \
            --dtype "${VLLM_DTYPE}" \
            --max-model-len "${VLLM_MAX_LEN}" \
            > "$VLLM_LOG" 2>&1 &
    VLLM_PID=$!
    echo "[vllm] pid=${VLLM_PID}"

    if [[ -n "${SLURM_GPUS_ON_NODE:-}" && "${SLURM_GPUS_ON_NODE}" -gt 1 ]]; then
        REST=$(seq -s, 1 $((SLURM_GPUS_ON_NODE - 1)))
        export CUDA_VISIBLE_DEVICES="$REST"
        echo "[gpu] pipeline driver sees CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
    else
        export CUDA_VISIBLE_DEVICES=""
        echo "[gpu] single GPU on node; pipeline driver runs CPU-only."
    fi

    export PIPELINE_LLM_BASE_URL="http://${NODE_HOST}:${VLLM_PORT}/v1"
    export PIPELINE_LLM_MODEL="${VLLM_MODEL}"

    VLLM_WAIT_SECS="${HORMUZ_VLLM_WAIT_SECS:-1800}"
    echo "[vllm] waiting up to ${VLLM_WAIT_SECS}s for ${PIPELINE_LLM_BASE_URL}/models"
    deadline=$(( $(date +%s) + VLLM_WAIT_SECS ))
    until curl -fsS "${PIPELINE_LLM_BASE_URL}/models" >/dev/null 2>&1; do
        if ! kill -0 "$VLLM_PID" 2>/dev/null; then
            record_bash_failure "${STAGE_PREFIX}_vllm" 1 \
                "vLLM exited before becoming healthy; see ${VLLM_LOG}"
            echo "[fatal] vLLM died during startup. Tail of log:"
            tail -n 40 "$VLLM_LOG" || true
            exit 1
        fi
        if [[ $(date +%s) -ge $deadline ]]; then
            record_bash_failure "${STAGE_PREFIX}_vllm" 1 \
                "vLLM did not become healthy within ${VLLM_WAIT_SECS}s"
            echo "[fatal] vLLM health check timed out. Tail of log:"
            tail -n 40 "$VLLM_LOG" || true
            exit 1
        fi
        sleep 10
    done
    echo "[vllm] healthy at ${PIPELINE_LLM_BASE_URL}"
else
    echo "[vllm] sidecar disabled (HORMUZ_USE_VLLM=${HORMUZ_USE_VLLM}, provider=${PIPELINE_LLM_PROVIDER})"
    case "$PIPELINE_LLM_PROVIDER" in
        anthropic)
            : "${ANTHROPIC_API_KEY:?PIPELINE_LLM_PROVIDER=anthropic but ANTHROPIC_API_KEY is unset}"
            ;;
        openai)
            : "${OPENAI_API_KEY:?PIPELINE_LLM_PROVIDER=openai but OPENAI_API_KEY is unset}"
            ;;
    esac
fi

# ------------------------------------------------------------------
# Helper: enumerate week (start, end) pairs in [start, end).
# Uses python (already on PATH via the conda env) so we don't depend
# on GNU date's `--date` extension or BSD `date -j`.
# ------------------------------------------------------------------
enumerate_weeks() {
    local s="$1" e="$2" step="$3"
    python - <<PY
from datetime import date, timedelta
s = date.fromisoformat("${s}")
e = date.fromisoformat("${e}")
step = timedelta(days=int("${step}"))
cur = s
while cur < e:
    nxt = min(cur + step, e)
    print(f"{cur.isoformat()} {nxt.isoformat()}")
    cur = nxt
PY
}

# ------------------------------------------------------------------
# Helper: run a manifest-driven stage as a serial loop on this node.
# Override SLURM_ARRAY_TASK_ID per iteration so the existing
# run_parameters.py / run_model.py scripts (which read that env var
# via stage_utils.get_array_task) work unchanged.
# ------------------------------------------------------------------
run_manifest_loop() {
    local stage="$1"      # tag for failure records
    local script="$2"     # python script path
    local count_file="$3" # manifest count sidecar written by dispatch_models.py

    if [[ ! -f "$count_file" ]]; then
        record_bash_failure "$stage" 1 "Manifest count file not found: $count_file"
        echo "[fatal] expected manifest count file at $count_file"
        return 1
    fi

    local n
    n="$(tr -d '[:space:]' < "$count_file")"
    if [[ -z "$n" || "$n" -le 0 ]]; then
        echo "[$stage] manifest is empty (count=$n); nothing to do."
        return 0
    fi

    echo "[$stage] dispatching ${n} task(s) serially on this node"
    local i rc
    for (( i=0; i<n; i++ )); do
        export SLURM_ARRAY_TASK_ID="$i"
        echo "─── [$stage] task ${i}/${n} ────────────────────────────────"
        # continue_on_failure=1 inside the loop: one bad (scenario,
        # model) pair must not halt the rest of the stage. Synthesis
        # records the gaps from the per-task status JSONs.
        safe_python "$stage" 1 -- python "$script"
        rc=$?
        if [[ $rc -ne 0 ]]; then
            echo "[$stage] task $i exited $rc; continuing."
        fi
    done
    unset SLURM_ARRAY_TASK_ID
    echo "[$stage] loop complete (${n} task(s))"
    return 0
}

# ------------------------------------------------------------------
# Helper: run the full Modules 1..4 pipeline for a single week.
# Mirrors the empire_ai_alpha.job stage flow (dispatch -> manifest
# loop) but inside an outer-week-loop iteration. Per-week env:
#   HORMUZ_RUN_ID            "weekly_<YYYYMMDD>"
#   HORMUZ_CRISIS_DESCRIPTION absolute path to per-week YAML
#   HORMUZ_LOG_DIR           per-week subfolder under BATCH_LOG_DIR
#   HORMUZ_RUN_SCRATCH       per-week subfolder under BATCH_SCRATCH
#   WANDB_RUN_GROUP          "weekly_<YYYYMMDD>"
#   WANDB_DIR                per-week subfolder so offline runs
#                            stay grouped per week
# ------------------------------------------------------------------
run_pipeline_for_week() {
    local week_start="$1"
    local week_end="$2"
    local crisis_yaml="$3"
    local week_log_dir="$4"
    local week_tag="${week_start//-/}"   # YYYYMMDD

    export HORMUZ_RUN_ID="weekly_${week_tag}"
    export HORMUZ_CRISIS_DESCRIPTION="$crisis_yaml"
    export HORMUZ_LOG_DIR="$week_log_dir"
    export WANDB_RUN_GROUP="weekly_${week_tag}"
    export WANDB_DIR="${week_log_dir}"

    if [[ -n "$HORMUZ_BATCH_SCRATCH" ]]; then
        export HORMUZ_RUN_SCRATCH="${HORMUZ_BATCH_SCRATCH}/weekly_${week_tag}"
        mkdir -p "$HORMUZ_RUN_SCRATCH"
    fi

    echo ""
    echo "============================================================"
    echo "  Pipeline rerun for week ${week_start} .. ${week_end}"
    echo "  HORMUZ_RUN_ID:             ${HORMUZ_RUN_ID}"
    echo "  HORMUZ_CRISIS_DESCRIPTION: ${HORMUZ_CRISIS_DESCRIPTION}"
    echo "  HORMUZ_LOG_DIR:            ${HORMUZ_LOG_DIR}"
    echo "  HORMUZ_RUN_SCRATCH:        ${HORMUZ_RUN_SCRATCH:-<unset>}"
    echo "  WANDB_RUN_GROUP:           ${WANDB_RUN_GROUP}"
    echo "============================================================"

    record_runtime_inventory "${STAGE_PREFIX}_${week_tag}_setup"

    # --- Stage 1: Module 1 - Scenario Generation ---------------------
    echo ""
    echo "══════ [${week_start}] Stage 1: Scenario Generation ══════"
    safe_python "${STAGE_PREFIX}_${week_tag}_01_scenarios" 0 -- \
        python slurm/scripts/run_scenarios.py
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "[week ${week_start}] Module 1 failed (rc=$rc); skipping rest of week."
        return $rc
    fi

    # --- Dispatch parameter manifest ---------------------------------
    echo ""
    echo "══════ [${week_start}] Dispatch: Parameter Manifest ══════"
    safe_python "${STAGE_PREFIX}_${week_tag}_dispatch_params" 0 -- \
        python slurm/scripts/dispatch_models.py parameters --run-id "${HORMUZ_RUN_ID}"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "[week ${week_start}] parameter dispatch failed (rc=$rc); skipping."
        return $rc
    fi
    local PARAM_COUNT_FILE="${PROJECT_ROOT}/data/pipeline_state/manifests/${HORMUZ_RUN_ID}_parameters_count.txt"

    # --- Stage 2: Module 2 - Parameter Extraction --------------------
    echo ""
    echo "══════ [${week_start}] Stage 2: Parameter Extraction ══════"
    run_manifest_loop "${STAGE_PREFIX}_${week_tag}_02_parameters" \
        "slurm/scripts/run_parameters.py" "$PARAM_COUNT_FILE"

    # --- Dispatch commodity-tier manifest (Stage 3a) -----------------
    echo ""
    echo "══════ [${week_start}] Dispatch: Commodity Manifest ══════"
    safe_python "${STAGE_PREFIX}_${week_tag}_dispatch_models_commodity" 0 -- \
        python slurm/scripts/dispatch_models.py models \
            --tier commodity --run-id "${HORMUZ_RUN_ID}"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "[week ${week_start}] commodity model dispatch failed (rc=$rc); skipping."
        return $rc
    fi
    local COMMODITY_COUNT_FILE="${PROJECT_ROOT}/data/pipeline_state/manifests/${HORMUZ_RUN_ID}_models_commodity_count.txt"

    # --- Stage 3a: commodity-tier model execution --------------------
    echo ""
    echo "══════ [${week_start}] Stage 3a: Commodity Tier Execution ══════"
    unset HORMUZ_MANIFEST_NAME
    export HORMUZ_MANIFEST_NAME="models_commodity"
    run_manifest_loop "${STAGE_PREFIX}_${week_tag}_03a_models_commodity" \
        "slurm/scripts/run_model.py" "$COMMODITY_COUNT_FILE"

    # --- Dispatch commodity_downstream manifest (Stage 3a-2) ---------
    # Forwards world_helium_model outputs into SimRLFab/Argonne ABM
    # via configs/upstream_forwarding_mapping.yaml.
    echo ""
    echo "══════ [${week_start}] Dispatch: Commodity-Downstream Manifest (Upstream Merge) ══════"
    safe_python "${STAGE_PREFIX}_${week_tag}_dispatch_models_commodity_downstream" 0 -- \
        python slurm/scripts/dispatch_models.py models \
            --tier commodity_downstream --run-id "${HORMUZ_RUN_ID}"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "[week ${week_start}] commodity_downstream dispatch failed (rc=$rc); skipping."
        return $rc
    fi
    local COMMODITY_DOWNSTREAM_COUNT_FILE="${PROJECT_ROOT}/data/pipeline_state/manifests/${HORMUZ_RUN_ID}_models_commodity_downstream_count.txt"

    # --- Stage 3a-2: commodity-downstream tier execution -------------
    echo ""
    echo "══════ [${week_start}] Stage 3a-2: Commodity-Downstream Tier Execution ══════"
    unset HORMUZ_MANIFEST_NAME
    export HORMUZ_MANIFEST_NAME="models_commodity_downstream"
    run_manifest_loop "${STAGE_PREFIX}_${week_tag}_03a2_models_commodity_downstream" \
        "slurm/scripts/run_model.py" "$COMMODITY_DOWNSTREAM_COUNT_FILE"

    # --- Dispatch macro-tier manifest (Stage 3b, upstream merge) -----
    echo ""
    echo "══════ [${week_start}] Dispatch: Macro Manifest (Upstream Merge) ══════"
    safe_python "${STAGE_PREFIX}_${week_tag}_dispatch_models_macro" 0 -- \
        python slurm/scripts/dispatch_models.py models \
            --tier macro --run-id "${HORMUZ_RUN_ID}"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "[week ${week_start}] macro model dispatch failed (rc=$rc); skipping."
        return $rc
    fi
    local MACRO_COUNT_FILE="${PROJECT_ROOT}/data/pipeline_state/manifests/${HORMUZ_RUN_ID}_models_macro_count.txt"

    # --- Stage 3b: macro-tier model execution ------------------------
    echo ""
    echo "══════ [${week_start}] Stage 3b: Macro Tier Execution ══════"
    export HORMUZ_MANIFEST_NAME="models_macro"
    run_manifest_loop "${STAGE_PREFIX}_${week_tag}_03b_models_macro" \
        "slurm/scripts/run_model.py" "$MACRO_COUNT_FILE"
    unset HORMUZ_MANIFEST_NAME

    # --- Stage 4: Module 4 - Output Synthesis ------------------------
    echo ""
    echo "══════ [${week_start}] Stage 4: Output Synthesis ══════"
    BASH_FAILURE_COUNT=$(ls -1 \
        "${PROJECT_ROOT}/data/pipeline_state/${HORMUZ_RUN_ID}_"*"_bash_failure_"*.json \
        2>/dev/null | wc -l | tr -d ' ')
    export HORMUZ_BASH_FAILURE_COUNT="${BASH_FAILURE_COUNT:-0}"
    echo "[synthesis] ${HORMUZ_BASH_FAILURE_COUNT} bash-layer failure record(s) from upstream stages."

    safe_python "${STAGE_PREFIX}_${week_tag}_04_synthesis" 0 -- \
        python slurm/scripts/run_synthesis.py
    rc=$?
    echo "[week ${week_start}] synthesis exit=${rc}"
    local synthesis_rc=$rc

    # --- Stage 4b: Output Validation ---------------------------------
    # Best-effort: a non-zero validation exit does NOT clobber the
    # synthesis rc. Same contract as the single-run drivers
    # (empire_ai_alpha.job, stonybrook_ai_cluster.job).
    echo ""
    echo "══════ [${week_start}] Stage 4b: Output Validation ══════"
    HORMUZ_VALIDATION_FAIL_ON_ERROR="${HORMUZ_VALIDATION_FAIL_ON_ERROR:-0}"
    local VALIDATION_ARGS=( --run-id "${HORMUZ_RUN_ID}" )
    if [[ "$HORMUZ_VALIDATION_FAIL_ON_ERROR" == "1" ]]; then
        VALIDATION_ARGS+=( --fail-on-error )
    fi
    safe_python "${STAGE_PREFIX}_${week_tag}_04b_validation" 1 -- \
        python slurm/scripts/run_validation.py "${VALIDATION_ARGS[@]}"
    local validation_rc=$?
    if [[ $validation_rc -ne 0 ]]; then
        echo "[week ${week_start}] validation exit=${validation_rc}; see"
        echo "                     data/reports/${HORMUZ_RUN_ID}/validation.md"
    fi

    # --- Stage 5: Quantitative CSV + qualitative narrative export ----
    echo ""
    echo "══════ [${week_start}] Stage 5: Results Export (CSV + Qualitative) ══════"
    HORMUZ_EXPORT_USE_LLM="${HORMUZ_EXPORT_USE_LLM:-1}"
    HORMUZ_EXPORT_EXEC_SUMMARY_LLM="${HORMUZ_EXPORT_EXEC_SUMMARY_LLM:-1}"
    local EXPORT_ARGS=( --run-id "${HORMUZ_RUN_ID}" )
    if [[ "$HORMUZ_EXPORT_USE_LLM" != "1" ]]; then
        EXPORT_ARGS+=( --no-llm )
    fi
    if [[ "$HORMUZ_EXPORT_EXEC_SUMMARY_LLM" != "1" ]]; then
        EXPORT_ARGS+=( --no-exec-summary )
    fi
    safe_python "${STAGE_PREFIX}_${week_tag}_05_export" 1 -- \
        python slurm/scripts/export_results.py "${EXPORT_ARGS[@]}"
    local export_rc=$?
    if [[ $export_rc -ne 0 ]]; then
        echo "[week ${week_start}] export exit=${export_rc}; CSVs / qualitative reports may be incomplete."
    fi

    # --- Stage 6: Per-week visualization (figures + dashboard) -------
    echo ""
    echo "══════ [${week_start}] Stage 6: Visualization (figures + dashboard) ══════"
    HORMUZ_VIZ_NO_TIMESERIES="${HORMUZ_VIZ_NO_TIMESERIES:-0}"
    local VIZ_ARGS=( --run-id "${HORMUZ_RUN_ID}" )
    if [[ "$HORMUZ_VIZ_NO_TIMESERIES" == "1" ]]; then
        VIZ_ARGS+=( --no-timeseries )
    fi
    safe_python "${STAGE_PREFIX}_${week_tag}_06_visualize" 1 -- \
        python slurm/scripts/visualize_results.py "${VIZ_ARGS[@]}"
    local viz_rc=$?
    if [[ $viz_rc -ne 0 ]]; then
        echo "[week ${week_start}] viz exit=${viz_rc}; figures may be incomplete."
    fi

    return $synthesis_rc
}

# ==================================================================
#  Main loop: enumerate weeks, build brief, optionally run pipeline.
#
#  We thread the previous week's plain-text brief into the next
#  week's summariser so the LLM sees the *evolution* of the crisis
#  rather than rebuilding the brief from scratch every time. This is
#  what makes the artefact a useful demonstration of "value of
#  rapidly updated analysis".
# ==================================================================
PREVIOUS_BRIEF=""
TOTAL_WEEKS=0
SUCCESSFUL_BRIEFS=0
SUCCESSFUL_PIPELINES=0
FAILED_PIPELINES=0

while read -r WEEK_START WEEK_END; do
    [[ -z "$WEEK_START" ]] && continue
    TOTAL_WEEKS=$((TOTAL_WEEKS + 1))

    WEEK_TAG="${WEEK_START//-/}"   # YYYYMMDD
    WEEK_LOG_DIR="${BATCH_LOG_DIR}/${WEEK_START}"
    WEEK_NEWS_DIR="${HORMUZ_NEWS_DATA_DIR}/${WEEK_START}"
    mkdir -p "$WEEK_LOG_DIR" "$WEEK_NEWS_DIR"

    CRISIS_YAML="${HORMUZ_WEEKLY_CRISIS_DIR}/${WEEK_START}.yaml"
    BRIEF_TXT="${WEEK_NEWS_DIR}/brief.txt"
    ARTICLES_JSON="${WEEK_NEWS_DIR}/articles.json"
    REPORT_JSON="${WEEK_NEWS_DIR}/report.json"

    echo ""
    echo "############################################################"
    echo "#  Week ${WEEK_START} .. ${WEEK_END}"
    echo "#  Per-week log:    ${WEEK_LOG_DIR}"
    echo "#  Per-week news:   ${WEEK_NEWS_DIR}"
    echo "#  Crisis YAML:     ${CRISIS_YAML}"
    echo "############################################################"

    # ---- Step 1: build the weekly brief + per-week crisis YAML ----
    # Set HORMUZ_LOG_DIR for this week so the brief-builder's bash
    # failure / runtime records (if any) land in the per-week folder.
    export HORMUZ_LOG_DIR="$WEEK_LOG_DIR"
    BRIEF_ARGS=(
        --week-start "$WEEK_START"
        --week-end   "$WEEK_END"
        --baseline   "$HORMUZ_BASELINE_CRISIS"
        --output     "$CRISIS_YAML"
        --sources-config "$HORMUZ_NEWS_CONFIG"
        --pipeline-config "$HORMUZ_CONFIG"
        --brief-out    "$BRIEF_TXT"
        --articles-out "$ARTICLES_JSON"
        --report-out   "$REPORT_JSON"
    )
    if [[ -n "$PREVIOUS_BRIEF" && -f "$PREVIOUS_BRIEF" ]]; then
        BRIEF_ARGS+=( --previous-brief "$PREVIOUS_BRIEF" )
        echo "[brief] threading previous brief from ${PREVIOUS_BRIEF}"
    fi

    safe_python "${STAGE_PREFIX}_${WEEK_TAG}_06_brief" 1 -- \
        python slurm/scripts/build_weekly_brief.py "${BRIEF_ARGS[@]}"
    BRIEF_RC=$?
    if [[ $BRIEF_RC -ne 0 ]]; then
        echo "[week ${WEEK_START}] brief builder exited ${BRIEF_RC}; skipping week."
        continue
    fi
    if [[ ! -f "$CRISIS_YAML" ]]; then
        echo "[week ${WEEK_START}] expected crisis YAML not found at ${CRISIS_YAML}; skipping."
        continue
    fi
    SUCCESSFUL_BRIEFS=$((SUCCESSFUL_BRIEFS + 1))
    PREVIOUS_BRIEF="$BRIEF_TXT"

    # ---- Step 2: re-run the pipeline (unless brief-only mode) -----
    if [[ "$HORMUZ_WEEKLY_SKIP_PIPELINE" == "1" ]]; then
        echo "[week ${WEEK_START}] HORMUZ_WEEKLY_SKIP_PIPELINE=1; brief saved at"
        echo "                     ${CRISIS_YAML}"
        continue
    fi

    if run_pipeline_for_week "$WEEK_START" "$WEEK_END" "$CRISIS_YAML" "$WEEK_LOG_DIR"; then
        SUCCESSFUL_PIPELINES=$((SUCCESSFUL_PIPELINES + 1))
    else
        FAILED_PIPELINES=$((FAILED_PIPELINES + 1))
    fi

done < <(enumerate_weeks "$HORMUZ_WEEKLY_START" "$HORMUZ_WEEKLY_END" "$HORMUZ_WEEKLY_STEP_DAYS")

# ==================================================================
#  Cross-week evolution visualisation (Module 6 -> Stage 7)
#
# Aggregates the per-week artefacts produced by Stages 5/6 above and
# writes a single dashboard showing how scenario predictions, model
# outputs, run health, and consistency flags evolve across the
# backfill window. This is the temporal counterpart to per-run Stage 6
# and the headline "value of rapid update" artefact.
# ==================================================================
if [[ "$HORMUZ_WEEKLY_SKIP_PIPELINE" != "1" && "$SUCCESSFUL_PIPELINES" -gt 0 ]]; then
    echo ""
    echo "════════════ Stage 7: Cross-Week Evolution Dashboard ════════════"
    # Use the parent batch id so the cross-week dashboard groups with
    # the per-week W&B runs under WANDB_RUN_GROUP_BATCH.
    export HORMUZ_LOG_DIR="$BATCH_LOG_DIR"
    export WANDB_RUN_GROUP="${WANDB_RUN_GROUP_BATCH}"
    safe_python "${STAGE_PREFIX}_07_cross_week_viz" 1 -- \
        python slurm/scripts/visualize_weekly_evolution.py \
            --batch-id "$HORMUZ_BATCH_ID"
    cross_week_rc=$?
    if [[ $cross_week_rc -ne 0 ]]; then
        echo "[cross-week viz] exit=${cross_week_rc}; aggregate dashboard may be incomplete."
    else
        echo "[cross-week viz] dashboard at" \
             "${PROJECT_ROOT}/data/reports/weekly_evolution/${HORMUZ_BATCH_ID}/figures/index.html"
    fi
fi

# ==================================================================
#  Summary
# ==================================================================
echo ""
echo "================================================================"
echo "  Hormuz weekly news pipeline complete on Empire AI Alpha"
echo "  Batch ID:                 ${HORMUZ_BATCH_ID}"
echo "  Window:                   ${HORMUZ_WEEKLY_START} .. ${HORMUZ_WEEKLY_END}"
echo "  Weeks attempted:          ${TOTAL_WEEKS}"
echo "  Briefs built:             ${SUCCESSFUL_BRIEFS}"
if [[ "$HORMUZ_WEEKLY_SKIP_PIPELINE" == "1" ]]; then
    echo "  Pipeline reruns:          skipped (HORMUZ_WEEKLY_SKIP_PIPELINE=1)"
else
    echo "  Pipeline reruns OK:       ${SUCCESSFUL_PIPELINES}"
    echo "  Pipeline reruns failed:   ${FAILED_PIPELINES}"
fi
echo "  Per-week crisis YAMLs:    ${HORMUZ_WEEKLY_CRISIS_DIR}/"
echo "  News artefacts:           ${HORMUZ_NEWS_DATA_DIR}/<date>/"
echo "  Per-week run state:       ${PROJECT_ROOT}/data/pipeline_state/weekly_*"
echo "  Per-week reports:         ${PROJECT_ROOT}/data/reports/weekly_*"
echo "                              csv/, qualitative/, figures/ per week (Stages 5-6)"
echo "                              validation.{json,md} per week (Stage 4b)"
if [[ "$HORMUZ_WEEKLY_SKIP_PIPELINE" != "1" && "$SUCCESSFUL_PIPELINES" -gt 0 ]]; then
    echo "  Cross-week dashboard:     ${PROJECT_ROOT}/data/reports/weekly_evolution/${HORMUZ_BATCH_ID}/figures/index.html"
fi
echo "  Batch log dir:            ${BATCH_LOG_DIR}/"
echo "                              driver-${SLURM_JOB_ID:-N/A}.out / .err  (symlinks)"
echo "                              vllm.log                                (if sidecar ran)"
echo "                              <YYYY-MM-DD>/                           (per-week subfolder)"
echo "                                runtime-*-${SLURM_JOB_ID:-N/A}-*.json"
echo "                                wandb/offline-run-*"
if [[ -n "$HORMUZ_BATCH_SCRATCH" ]]; then
    echo "  Batch scratch tree:       ${HORMUZ_BATCH_SCRATCH}/"
fi
echo "  Driver log:               ${SBATCH_OUT}"
echo "                            ${SBATCH_ERR}"
echo "  W&B:                      project=${WANDB_PROJECT}"
echo "                            batch_group=${WANDB_RUN_GROUP_BATCH}"
echo "                            mode=${WANDB_MODE}"
if [[ "$WANDB_MODE" == "offline" ]]; then
    echo "                            Sync from a login node with:"
    echo "                              cd ${PROJECT_ROOT} && wandb sync ${BATCH_LOG_DIR}/*/wandb/offline-run-*"
fi
echo "  Finished at:              $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "================================================================"

# Exit non-zero only if every pipeline attempt failed (and we tried at
# least one). Brief-only runs always exit zero on completion.
if [[ "$HORMUZ_WEEKLY_SKIP_PIPELINE" != "1" \
      && "$SUCCESSFUL_PIPELINES" -eq 0 \
      && "$FAILED_PIPELINES" -gt 0 ]]; then
    exit 1
fi
exit 0
